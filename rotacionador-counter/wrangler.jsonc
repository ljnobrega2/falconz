{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "rotacionador-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "GlobalRotator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GlobalRotator"]
    }
  ]
}
