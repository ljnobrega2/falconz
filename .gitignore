# Dependências (restauradas via composer install / npm install)
/vendor/
admin-ui/node_modules/
node_modules/

# Build / cache
.phpunit.result.cache
admin-ui/dist/
# Compilados: o Dockerfile de cada UI roda `npm run build` no servidor, entao
# versionar o resultado so cria divergencia permanente entre repo e producao.
checkout-ui/dist/
portal-ui/dist/
admin-ui/*.tsbuildinfo
admin-ui/tsconfig*.tsbuildinfo
*.log

# Segredos / ambiente (NUNCA versionar — usar .env.example como referência)
.env
.env.local
*.pem
*.key

# Config local de ferramentas
.claude/settings.local.json
*.local.json
.claude/worktrees/
.tmpwork/

# SO
.DS_Store
**/.DS_Store
Thumbs.db

# Dumps WP (dados reais, não commitar)
/_import/
*.sql
# Exceção: migrações de schema versionadas (NÃO são dumps de dados)
!infra/postgres/*.sql
.wrangler/
