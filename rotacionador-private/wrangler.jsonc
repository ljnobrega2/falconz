{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rotacionador-privado",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "AccountDirectory" },
      { "name": "CAMPAIGNS", "class_name": "UserCampaigns" }
    ]
  },
  "exports": {
    "AccountDirectory": { "type": "durable-object", "storage": "sqlite" },
    "UserCampaigns": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
